# Eclipse 워크스페이스 메타데이터
.metadata/

# 컴파일 결과물 (모든 하위 프로젝트 포함)
build/
**/build/

# Eclipse IDE 설정
.settings/
**/.settings/

# JAR 라이브러리 (모든 하위 경로)
**/WEB-INF/lib/*.jar

# Tomcat 서버 설정 (계정 정보 포함 가능)
Servers/

# 컴파일된 클래스 파일
*.class

# 로그 파일
*.log

# 실습 완료 프로젝트 - 모두 정상 추적 중
# JSP0819, JSP0828, JSP0904, JSP0911, BookMarket 추적 대상